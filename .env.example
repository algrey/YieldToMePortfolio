# Production/preview requests will fail closed until these are configured by AUTH-001.
CLOUDFLARE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-me

# Local auth remains disabled until AUTH-001 implements its loopback-only adapter.
LOCAL_AUTH_USER=

# Yahoo-compatible v1 source is server-only and restricted to the owner’s personal use.
MARKET_DATA_PROVIDER=yahoo-best-effort
MARKET_DATA_PERSONAL_USE_ONLY=true
# Optional supported free daily-history/FX fallback; leave blank unless configured.
ALPHA_VANTAGE_API_KEY=
