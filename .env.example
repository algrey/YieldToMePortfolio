# Production/preview requests will fail closed until these are configured by AUTH-001.
CLOUDFLARE_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace-me

# Local auth remains disabled until AUTH-001 implements its loopback-only adapter.
LOCAL_AUTH_USER=

# Provider activation requires the SPK-002 rights decision and Worker secret.
MARKET_DATA_PROVIDER=disabled
MARKET_DATA_RIGHTS_APPROVED=false
MARKET_DATA_API_KEY=
