{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": ["~/.npm", "~/.cache"]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org", "*.npmjs.org",
        "github.com", "api.github.com", "codeload.github.com",
        "raw.githubusercontent.com",
        "api.anthropic.com"
      ]
    }
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)"],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(git checkout *)",
      "Bash(rm *)",
      "Bash(node *)", 
      "Bash(npm *)",  
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git mv *)",
      "Bash(awk -F/ 'NF==1')",
      "Bash(awk -F/ '{print $1}')",
      "Bash(mkdir -p docs/source-evidence)"
    ]
  }
}
